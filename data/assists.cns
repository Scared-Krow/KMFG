hitsound   = 5,2
guardsound = 6,0
ground.type = High
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -4
air.hittime = 60
air.velocity = -2,15
guard.ctrltime = 11
guard.hittime = 11
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
air.fall = 1
fall.yvelocity = cond(root,Map(GroundBounce)=0,-5.2,0)
p2facing = 1
getpower = 0,0


[State 1000, 7]
type = DestroySelf
trigger1 = animtime = 0
trigger2 = root,movetype = H
trigger3 = movetype = H

