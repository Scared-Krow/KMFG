[Function glow(alpha,quality,size,r,g,b, p, id, ignorehit, movehitpause)] 
#alpha, quality, size, r, g, b, sprpriority, updatehitpause, movehitpause

#alpha: 		controls the opacity of explods
#quality: 		controls distribution of the explod scattering(divided by 10 and then multiplied by nested loop)
#size: 			glow radius;
#r,g,b: 		colors;
#sprpriority: 	sprpriority of the explods (usually smaller than 0);
#ignorehit: 	updates the anim during hitpause;
#movehitpause: 	lets the explod run during hitpause;(controls ignorehitpause parameter on explods)

ignoreHitPause{
	let a = $alpha / ($quality*0.25);
	let q = float($quality/10);
	if ((hitPauseTime && $ignorehit) || !hitPauseTime || isAsserted(animatehitpause)) && !pauseTime{
	map(glow.frame) := animElemNo(0);}
	removeExplod{id: $id;}
	
	#p2facing fix
	if getHitVar(frame) && map(previous_facing) = facing && getHitVar(facing)
	{
		if (facing != (-playerId(getHitVar(id)), facing) * getHitVar(facing))
		{
			 let f = -1;
		}
	}
	map(previous_facing) := facing;
	#
	for i = 0; $q; 1{
		for h = 0; $q; 1
		{
			if (($h%2 = 0 && $i%2 = 0) || ($h%2 = 1 && $i%2 = 1)) && (gameTime%2 = 0)
			{
				explod{
					anim: anim; 
					id: $id; 
					sprpriority: $p; 
					postype: p1;
					pos: -($size/2)+$h*($size/$q),-($size/2)+$i*($size/$q);
					removetime: 2;
					animelem: map(glow.frame);
					scale: 1 * const(size.xscale) * (scale x), 1 * const(size.yscale) * (scale y);
					trans: addalpha;
					alpha: $a,255-$a;
					ownpal: 1;
					under: 1;
					facing: ifElse($f = -1, -1, 1);
					angle: angle;
					palfx.time: -1;
					palfx.add: 256,256,256;
					palfx.mul: $r,$g,$b;
					pausemovetime: -1;
					supermovetime: -1;
					ignorehitpause: $movehitpause;
					animplayerno: animPlayerNo;
				}
			}
						
			if (($h%2 = 0 && $i%2 = 1) || ($h%2 = 1 && $i%2 = 0)) && (gameTime%2 = 1)
			{
				explod{
					anim: anim; 
					id: $id; 
					sprpriority: $p; 
					postype: p1;
					pos: -($size/2)+$h*($size/$q),-($size/2)+$i*($size/$q);
					removetime: 2;
					animelem: map(glow.frame);
					scale: 1 * const(size.xscale) * (scale x), 1 * const(size.yscale) * (scale y);
					trans: addalpha;
					alpha: $a,255-$a;
					ownpal: 1;
					under: 1;
					facing: ifElse($f = -1, -1, 1);
					angle: angle;
					palfx.time: -1;
					palfx.add: 256,256,256;
					palfx.mul: $r,$g,$b;
					pausemovetime: -1;
					supermovetime: -1;
					ignorehitpause: $movehitpause;
					animplayerno: animPlayerNo;
				}
			}
		}
	}
}

[StateDef +1]
	ignoreHitPause
	{
		if name != "Daki"	
		{
			#alpha, quality, size, r, g, b, priority, id, updatehitpause, movehitpause(explod)
			call glow(256, 20, 2, 0,0,0, 1, 92000, 1, 1);
			
			#------[Examples]-----
			#[Big]
			#call glow(185, 65, 20, 0, 255, 0, -2, 92000, 1, 1);
			
			#[Blue Big]
			#call glow(185, 65, 20, 0, 155, 255, -2, 92000, 1, 1);
			
			#[Red Big]
			#call glow(185, 65, 20, 255, 0, 0, -2, 92000, 1, 1);
			#--------------------
		}
		if name = "Daki"
		{
			call glow(256, 50, 5, 200,210,20, 1, 92000, 1, 1);
		}
	}