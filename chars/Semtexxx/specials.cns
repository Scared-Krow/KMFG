trigger1 = Time = 2
value = 0, 1

[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit && combocount=1
value = Map(DamageScaling)*.95
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit && combocount>1
value = Map(DamageScaling)-.05
map = "DamageScaling"
ignorehitpause = 1
persistent = 0

[State 0, PosSet]
type = PosSet
triggerall = time < 16
trigger1 = pos y > -12
y = -12
[State 0, VelSet]
type = VelMul
trigger1 = pos y = -12
x = .975

[State 640, 3]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = A, SA
damage = ceil(cond(65*Map(DamageScaling) < 6, 6, 65*Map(DamageScaling)))
guardflag = HA
priority = 4
pausetime = 15,15
sparkno = 1
sparkxy = -10,-40
hitsound   = 9,2
guardsound = 6,0
animtype = Med
ground.type = High
ground.slidetime = 12
ground.hittime  = 18
ground.velocity = -8,10
guard.velocity = -5
air.velocity = -8,10
air.hittime = 64
fall = 1
guard.ctrltime = 14
guard.hittime = 14
fall.yvelocity = 0
p2facing = 1
air.cornerpush.veloff = 0
guard.dist = 0
id = 5420

[State 0, TargetState]
type = TargetState
triggerall = enemy,statetype = A && NumTarget(5420)
trigger1 = movehit 
value = 5420
ID = 5420
ignorehitpause = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 6
statetype = A     
movetype = I        
physics = A 

