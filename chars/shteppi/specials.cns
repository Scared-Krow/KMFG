;---------------------------------------------------
;236B
[Statedef 1000]
type    = S
movetype= A
physics = S
anim = 1000
velset = vel x,0
poweradd = 0
ctrl = 0

[State 0, Width]
type = Width
trigger1 = time > 5
edge = 0,0
player = 10,0


[State 0, PosAdd]
type = PosAdd
trigger1 = animelem = 1
trigger2 = animelem = 2
trigger3 = animelem = 3
x = 5

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 2
x = 10

[State -2, PushBack]
type = mapset
triggerall = enemy,statetype != A
trigger1 = movehit && combocount>5
value = Map(PushBack)+1
map = "PushBack"
ignorehitpause = 1
persistent = 0
[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit && combocount=1
value = Map(DamageScaling)*.85
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit && combocount>1
value = Map(DamageScaling)-.075
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Hitstun Scaling]
type = mapset
triggerall = enemy,statetype = A && enemy,movetype = H
trigger1 = movehit
value = Map(HitstunScaling)+1
map = "HitstunScaling"
ignorehitpause = 1
persistent = 0

[State 210, 2]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = C, SA
damage = ceil(cond(50*Map(DamageScaling) < 5, 5, 50*Map(DamageScaling)))
guardflag = LA
animtype = back
priority = 3
pausetime = 11,11
sparkno = 1
sparkxy = -10,-10
hitsound   = 5,1
guardsound = 6,0
ground.slidetime = 12
ground.hittime  = 20
ground.velocity = -3,-4
air.hittime = ceil(cond(30-Map(HitstunScaling) < 25, 25, 30-Map(HitstunScaling)))
air.velocity = -3,-3
guard.ctrltime = 14
guard.hittime = 14
forcenofall = 1
ground.cornerpush.veloff = -3-(Map(PushBack))
fall.yvelocity = 0
p2facing = 1

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .99


[State 1000, 7]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

