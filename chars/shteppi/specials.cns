;Louie Leap (Run)
[Statedef 1111]
type    = S
movetype= I
physics = S
anim = 1110
velset = 0,0
poweradd = 0
ctrl = 0

[State 0, VelSet]
type = VelSet
trigger1 = 1
x = 3.2

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 1000, 7]
type = ChangeState
triggerall = facing = 1
trigger1 = pos x > enemy, pos x - 60
value = 1112
[State 1000, 7]
type = ChangeState
triggerall = facing = -1
trigger1 = pos x < enemy, pos x + 60
value = 1112


[State 1000, 7]
type = ChangeState
trigger1 = frontedgedist < -45
value = 1120

