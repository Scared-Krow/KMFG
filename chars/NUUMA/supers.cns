; Shaking Revive
[Statedef 3051]
type    = A
movetype= H
physics = N
velset = 0,0

[State 0, PosAdd]
type = PosAdd
trigger1 = time = 0
y = -2

[State 5020, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
value = 5030

[State 5020, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5020, 5]
type = ChangeState
trigger1 = HitShakeOver
value = 3052

;---------------------------------------------------------------------------
;Revive
[Statedef 3052]
type    = A
movetype= H
physics = N
ctrl = 0
velset = -5,-5

[State 5030, 1]
type = ChangeAnim
trigger1 = Anim != [5000, 5199]
trigger1 = SelfAnimExist(5030)
value = 5030

[State 5030, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 3]
type = HitVelSet
trigger1 = Time = 0
x = 5
y = -5

[State 0, VelMul]
type = VelMul
trigger1 = time > 1
x = .99

[State 0, VelAdd]
type = VelAdd
trigger1 = 1
y = .05


[State 5030, 5]
type = ChangeState
trigger1 = Pos Y >= 0
value = 3053

