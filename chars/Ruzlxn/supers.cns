;Rock
[Statedef 3110]
type    = U
movetype= A
physics = N
anim = 3110
velset = 1,-6
sprpriority = -5
ctrl = 0

[State 0, PosSet]
type = PosSet
trigger1 = time = 0
y = 0

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 0

[State 0, Width]
type = Width
trigger1 = 1 
edge = -10,-10
player = -10,-10


[State -2, Rock Check]
type = mapadd
trigger1 = time = 0
value = 1
map = "Rocks"
redirectID = root,ID

[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit=1 && combocount=1
value = root,Map(DamageScaling)*.8
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
redirectID = root,ID
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit=1 && combocount>1
value = root,Map(DamageScaling)-.1
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
redirectID = root,ID
[State -2, Hitstun Scaling]
type = mapset
triggerall = enemy,statetype = A && enemy,movetype = H
trigger1 = movehit=1
value = root,Map(HitstunScaling)+1
map = "HitstunScaling"
ignorehitpause = 1
persistent = 0
redirectID = root,ID

[State 0, EnvShake]
type = EnvShake
trigger1 = time = 1
time = 6
freq = 30
ampl = -2
phase = 40
ignorehitpause = 1

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = time = 10
statetype = A      ;S,A,C,L
movetype = I        ;I,A,H
physics = N         ;A,C,S,N

[State 0, VelSet]
type = VelAdd
trigger1 = 1
y = .3

[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !Movereversed
attr = S,HP                     ;Attribute: Standing, Normal Attack
damage = ceil(cond(50*root,Map(DamageScaling) < 5, 5, 50*root,Map(DamageScaling))),5
animtype = Back                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 6, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 2,5                ;Time attacker pauses, time opponent shakes
sparkno = 2                     ;Spark anim no (Def: set above)
sparkxy = -10, -5               ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 16           ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = -6,-4
down.velocity = -3,-4
guard.velocity = -8
airguard.velocity = -5,-2     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.animtype = back                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -6,-2
air.hittime = 50
fall = 1
fall.yvelocity = 0
guard.ctrltime = 12
guard.hittime = 12
getpower = 0
air.cornerpush.veloff = 0
ground.cornerpush.veloff = 0
down.cornerpush.veloff = 0

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .9

[State 0, Helper]
type = Helper
triggerall = root,Map(Rocks)<10
trigger1 = time = 9
helpertype = Normal ;Player
name = "Rock"
ID = 3110
stateno = 3110
pos = 35,0
postype = P1    ;P2, Front, Back, Left, Right
facing = 1
keyctrl = 0
ownpal = 0
ignorehitpause = 1

[State 0, DestroySelf]
type = ChangeState
trigger1 = frontedgedist < -25
trigger2 = pos y >= -8 && time > 10
value = 3111

