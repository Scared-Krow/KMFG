;---------------------------------------------------------------------------
;236C
[Statedef 1000]
type    = S
movetype= A
physics = S
ctrl = 0
velset = vel x * .8
sprpriority = 3

[State 0, Turn]
type = Turn
trigger1 = animelem = 1 && facing = enemy,facing

[State -2, Fatal Counter]
type = mapset
trigger1 = 1
value = 1
map = "FatalCounter"
ignorehitpause = 1

[State 0, PosAdd]
type = PosAdd
trigger1 = animelem = 4
x = 5

[State 0, PosAdd]
type = PosAdd
trigger1 = animelem = 5
x = 12

[State 0, VarSet]
type = VarSet
trigger1 = !time
fv = 9
value = StateNo

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = anim!=1000
value = 1000

;This varset is used to count if armor has been used during this state, you can technically use an 
;explod to count this but i believe we already have an armor variable counting how many times armor is used
[State 0, VarSet]
type = VarSet
trigger1 = animelem = 1
v = 46
value = 0
;This hitoverride actually declares where to go with the actual state,
;you don't want to use the time state because it'll reset every time you go back to armor
[State 0, HitOverride]
type = HitOverride
triggerall = Map(Rage)=1
trigger1 = Animelemno(0) = [2,4]
trigger1 = var(46) < 99
attr = SCA,NA,SA,NP,SP,HP,HA
slot = 2
stateno = 666999 
time = 1
forceair = 0

[State -2, Armoring]
type = mapset
trigger1 = Animelemno(0) = [2,4]
value = 1
map = "ArmorActive"
[State -2, Armoring]
type = mapset
trigger1 = Animelemno(0) != [2,4]
value = 0
map = "ArmorActive"

[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit && combocount=1
value = Map(DamageScaling)*.875
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit && combocount>1
value = Map(DamageScaling)-.1
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Hitstun Scaling]
type = mapset
triggerall = enemy,statetype = A && enemy,movetype = H
trigger1 = movehit
value = Map(HitstunScaling)+.25
map = "HitstunScaling"
ignorehitpause = 1
persistent = 0

[State -3, Lv1 Shadows]
type = afterimage
trigger1 = Map(Rage)=1 && time = 0
time = 30
length = 6
framegap = 2
timegap = 2
paladd = 250, 0, 0
palmul = 1, 1,1
palcontrast = 200, 0, 25
palbright = 200, 0 , 25
trans = add1

[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = S,SA                     ;Attribute: Standing, Normal Attack
damage = ceil(cond(90*Map(DamageScaling)+cond(Map(Rage)=1,20,0) < 20, 20, 90*Map(DamageScaling)+cond(Map(Rage)=1,20,0))),20
animtype = Back                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = HA                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 6, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 13,13               ;Time attacker pauses, time opponent shakes
sparkno = 2                   ;Spark anim no (Def: set above)
sparkxy = -10, -50               ;X-offset for the "hit spark" rel. to p2,
hitsound = 5,10                ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 50            ;Time that the opponent slides back
ground.hittime  = 60
ground.velocity = -2,20
guard.velocity = -5
guard.slidetime = 12
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -2,20
air.hittime = 60
fall = 1
fall.yvelocity = cond(Map(GroundBounce)=0,-6.2,0)
down.velocity = -1,cond(Map(GroundBounce)=0,20,-1)
down.bounce = cond(Map(GroundBounce)=0,-6.2,0)
down.hittime = 60
guard.ctrltime = 20
guard.hittime = 20
envshake.time = 12
envshake.freq = 120
envshake.phase = 900
envshake.ampl = 4
ground.cornerpush.veloff = -2
air.cornerpush.veloff = -2
id = 5420

[State 0, EnvShake]
type = EnvShake
trigger1 = animelem = 5 && !MoveContact && !MoveReversed
time = 10
freq = 80
ampl = 4
phase = 140
ignorehitpause = 1

[State 0, TargetState]
type = TargetState
triggerall = Map(GroundBounce)=1
triggerall = (enemy,statetype = A || enemy,statetype = L)&& NumTarget(5420)
trigger1 = movehit=1
value = 5420
ID = 5420
ignorehitpause = 1

[State 200, 2]
type = PlaySnd
trigger1 = animelem = 5
value = F4, 2

[State -2, IsRage]
type = mapset
trigger1 = time = 0 && Map(Rage)=1
value = 1
map = "Enraged"
ignorehitpause = 1
[State -2, IsRage]
type = mapset
trigger1 = time = 0 && Map(Rage)=0
value = 0
map = "Enraged"
ignorehitpause = 1

;Rage Cancel
[State -1, Run Fwd]
type = ChangeState
value = 101
triggerall = command = "FF"
triggerall = Map(Enraged)=1
trigger1 = movecontact

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 7
statetype = S       
movetype = I        
physics = S  

[State 210, 4]
type = SprPriority
trigger1 = AnimElem = 5
value = 2

[State -2, Starter Damage Scaling]
type = mapset
trigger1 = animelem = 6 || movecontact
value = 0
map = "Rage"
ignorehitpause = 1


[State 210, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

