air.velocity = -4,5        ;X-velocity at which opponent is pushed,
air.hittime = 50
fall = 1
fall.yvelocity = 0
guard.ctrltime = 13
guard.hittime = 13
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2facing = 1
id = 5111

