;---------------------------------------------------------------------------
;236236C
[Statedef 3000]
type    = U
movetype= A
physics = N
anim = 3000
velset = 0,0
ctrl = 0
poweradd = -500

[State 0, VelSet]
type = VelSet
trigger1 = 1
x = 0
y = 0


[State 0, SuperPause]
type = SuperPause
trigger1 = time = 16
time = 24
darken = 1
p2defmul = 1


[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = S, HA                 ;Attribute: Standing, Normal Attack
damage = ceil(cond(100*Map(DamageScaling) < 35, 35, 100*Map(DamageScaling))),25
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 10,30
guard.pausetime = 10,5
sparkno = 0                      
sparkxy = -10, -70              ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = -3,-5
guard.velocity = -2
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -3,-5        ;X-velocity at which opponent is pushed,
air.hittime = 50
fall = 1
fall.yvelocity = 0
guard.ctrltime = 13
guard.hittime = 13
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2facing = 1
yaccel = .26

[State 0, Turn]
type = Turn
triggerall = animelem = 4
trigger1 = facing = enemy,facing

[State 0, PosSet]
type = PosSet
trigger1 = animelem = 4
x = cond(enemy,facing=-1,enemy,pos x - 40,enemy, pos x + 40)
y = cond(enemy, pos y>=-5,enemy, pos y-10, enemy, pos y)


[State 0, PosSet]
type = PosSet
trigger1 = animelem = 11
y = 0

[State 1000, 7]
type = ChangeState
trigger1 = movehit
value = 3001
ctrl = 0

[State 1000, 7]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;236236C Active
[Statedef 3001]
type    = U
movetype= A
physics = N
anim = 3001
velset = 1,0
ctrl = 0

[State 0, VelSet]
type = VelSet
trigger1 = 1
x = 0
y = 0


[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = S, HA                 ;Attribute: Standing, Normal Attack
damage = ceil(cond(150*Map(DamageScaling) < 60, 60, 150*Map(DamageScaling))),25
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 10,15
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = -10, -70              ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = -8,-2.5
guard.velocity = -2
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -4,5        ;X-velocity at which opponent is pushed,
air.hittime = 50
fall = 1
fall.yvelocity = 0
guard.ctrltime = 13
guard.hittime = 13
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2facing = 1

[State 0, PosSet]
type = PosSet
trigger1 = animelem = 11
y = 0

[State 1000, 7]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;AIR SUPER TEST
[Statedef 3100]
type    = A
movetype= A
physics = N
anim = 3100
velset = 0,0
ctrl = 0
poweradd = -500

[State 0, EnvShake]
type = EnvShake
trigger1 = time > 5 && time < 35
time = 2
freq = 40*(time/10)
ampl = -4*(time/10)
phase = 40*(time/10)


[State 0, SuperPause]
type = SuperPause
trigger1 = time = 0
time = 30
darken = 1
p2defmul = 1
movetime = 30


[State 200, 1]
type = HitDef
trigger1 = !movereversed && !movecontact
attr = S, HP                   ;Attribute: Standing, Normal Attack
damage = ceil(cond(275*Map(DamageScaling) < 120, 120, 275*Map(DamageScaling))),25
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAFD                   ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 15,15               ;Time attacker pauses, time opponent shakes
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = -10, -70              ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = -2,20
guard.velocity = -2
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -2,20        ;X-velocity at which opponent is pushed,
air.hittime = 50
fall = 1
fall.yvelocity = 0
guard.ctrltime = 13
guard.hittime = 13
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2facing = 1


[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 4
statetype = A       ;S,A,C,L
movetype = I        ;I,A,H
physics = A         ;A,C,S,N



[State 1000, 7]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1