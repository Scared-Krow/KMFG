;---------------------------------------------------------------------------
;236236C
[Statedef 3000]
type    = U
movetype= A
physics = N
anim = 3000
velset = 0,0
ctrl = 0
poweradd = -500

[State 0, VelSet]
type = VelSet
trigger1 = 1
x = 0
y = 0


[State 0, SuperPause]
type = SuperPause
trigger1 = time = 16
time = 24
darken = 1
p2defmul = 1


[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = S, HA                 ;Attribute: Standing, Normal Attack
damage = ceil(cond(80*Map(DamageScaling) < 30, 30, 80*Map(DamageScaling))),25
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 10,999
guard.pausetime = 10,5
sparkno = 0                      
sparkxy = -10, -70              ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = -3,-5
guard.velocity = -2
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -3,-5        ;X-velocity at which opponent is pushed,
air.hittime = 50
air.fall = 1
fall.yvelocity = 0
guard.ctrltime = 13
guard.hittime = 13
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
p2facing = 1
yaccel = .26

[State 0, Turn]
type = Turn
triggerall = animelem = 4
trigger1 = facing = enemy,facing

[State 0, PosSet]
type = PosSet
trigger1 = animelem = 4
x = cond(enemy,facing=-1,enemy,pos x - 40,enemy, pos x + 40)
y = cond(enemy, pos y>=-5,enemy, pos y-10, enemy, pos y)




[State 1000, 7]
type = ChangeState
trigger1 = movehit
value = 3001
ctrl = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 8
statetype = A       
movetype = I        
physics = N       

[State 0, VelAdd]
type = VelAdd
trigger1 = time > 24
y = 2
[State 0, VelMul]
type = VelMul
trigger1 = time > 24
y = 1.5




[State 1000, 7]
type = ChangeState
triggerall = time > 27
trigger1 = pos y >= 5
value = 3002


