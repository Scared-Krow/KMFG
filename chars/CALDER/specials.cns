;---------------------------------------------------------------------------
;236D Biney
[Statedef 1201]
type    = U
movetype= A
physics = N
anim = 1200
velset = cond((p2dist x > 80)&&prevstateno=500,vel x*.6,3),0
ctrl = 0
sprPriority = -6

[State 3000, StayOnTarget]
triggerall = time = [0,10]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .92
y = .9

[State 0, VelSet]
type = VelSet
triggerall = anim = 1201
trigger1 = animelem = 2
x = 9

[State 0, VelSet]
type = VelSet
triggerall = anim = 1201
trigger1 = animelemno(0) = [3,5]
x = 6

[State 0, VelMul]
type = VelMul
trigger1 = time > 20
x = .8

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AP,AT
time = 1

[State 0, ChangeState]
type = ChangeState
triggerall = enemy,movetype = A
trigger1 = ClsnOverlap(clsn2, enemynear,ID, clsn1)
value = 599
ctrl = 0

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = anim = 1200 && time != [14,25]
trigger1 = root,command != "holdb" && time >= 12
trigger2 = time >= 100
value = 1201

[State 0, Turn]
type = Turn
triggerall = anim = 1200
trigger1 = animelem = 4

[State 0, PosSet]
type = PosSet
trigger1 = pos y >= 0
y = 0

[State 0, PosSet]
type = PosSet
triggerall = anim = 1200
trigger1 = time = 16
x = enemy, pos x-(50*facing)
y = enemy, pos y-5

[State 0, PosAdd]
type = veladd
trigger1 = anim = 1200
trigger1 = time > 16
x = (enemy, vel x * .25)*cond(facing=enemy,facing,1,-1)
y = enemy, vel y * .1


[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit=1 && combocount=1
value = root,Map(DamageScaling)*.85
map = "DamageScaling"
persistent = 0
redirectID = root,ID
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit=1 && combocount>1
value = root,Map(DamageScaling)-.1-cond(root,Map(qcfD),.1,0)
map = "DamageScaling"
persistent = 0
redirectID = root,ID
[State -2, Hitstun Scaling]
type = mapset
triggerall = enemy,statetype = A && enemy,movetype = H
trigger1 = movehit=1
value = root,Map(HitstunScaling)+1
map = "HitstunScaling"
persistent = 0
redirectID = root,ID

[State 200, 1]
type = HitDef
triggerall = anim = 1201
trigger1 = animelem = 2
attr = S,NP                     ;Attribute: Standing, Normal Attack
damage = ceil(cond(35*root,Map(DamageScaling) < 3, 3, 35*root,Map(DamageScaling))),5
animtype = Back                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 1, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 5,5                ;Time attacker pauses, time opponent shakes
sparkno = 2                     ;Spark anim no (Def: set above)
sparkxy = -10, -50               ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 1                 ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 20            ;Time that the opponent slides back
ground.hittime  = 20
ground.velocity = -13+(p2dist x/8)
guard.velocity = -16+(p2dist x/8)
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -12+(p2dist x/8),cond(root,Map(WallBounce)=0,-3,-1)       ;X-velocity at which opponent is pushed,
air.hittime = (cond(35-root,Map(HitstunScaling) < 20, 20, 35-root,Map(HitstunScaling)))
forcenofall = 1
fall.yvelocity = 0
guard.ctrltime = 8
guard.hittime = 8
p2facing = 1
guard.dist = 0

[State 200, 1]
type = HitDef
triggerall = anim = 1201
trigger1 = animelem = 6
attr = S,NP                     ;Attribute: Standing, Normal Attack
damage = ceil(cond(50*root,Map(DamageScaling) < 5, 5, 50*root,Map(DamageScaling))),5
animtype = Back                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 6, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 6,6                ;Time attacker pauses, time opponent shakes
sparkno = 2                     ;Spark anim no (Def: set above)
sparkxy = -10, -50               ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 3                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 10             ;Time that the opponent slides back
ground.hittime  = 45
ground.velocity = cond(root,Map(WallBounce)=0,-20,-7),-5
guard.velocity = -8
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = cond(root,Map(WallBounce)=0,-20,-7),cond(root,Map(WallBounce)=0,-4.5,-2)       ;X-velocity at which opponent is pushed,
air.hittime = 60
fall = 1
fall.yvelocity = 0
guard.ctrltime = 8
guard.hittime = 8
p2facing = 1
guard.dist = 0
id = 5400

[State 0, TargetState]
