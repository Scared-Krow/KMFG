;---------------------------------------------------------------------------
;22D
[Statedef 1000]
type    = U
movetype= I
physics = N
ctrl = 0
anim = 1000
velset = 0,0
sprpriority = -1
facep2 = 1


[State 0, PosSet]
type = PosSet
trigger1 = pos y > 0
y = 0

[State -2, StoreBiney]
type = mapset
trigger1 = time = 0
value = helper(500), vel x
map = "BineyVelX"
ignorehitpause = 1
persistent = 0
[State -2, StoreBiney]
type = mapset
trigger1 = time = 0
value = helper(500), vel y
map = "BineyVelY"
ignorehitpause = 1
persistent = 0

[State -2, StoreBiney]
type = mapset
trigger1 = time = 0
value = helper(500), pos x
map = "BineyPosX"
ignorehitpause = 1
persistent = 0
[State -2, StoreBiney]
type = mapset
trigger1 = time = 0
value = helper(500), pos y
map = "BineyPosY"
ignorehitpause = 1
persistent = 0


[State 0, PosAdd]
type = PosSet
trigger1 = animelem = 4
x = Map(BineyPosX) + 20
y = cond(Map(BineyPosY)<0,Map(BineyPosY) - 20,-5)

[State 0, ChangeState]
type = ChangeState
trigger1 = animelem = 5
value = 598
ctrl = 0
redirectID = helper(500),ID

[State 0, Turn]
type = Turn
triggerall = facing = enemy,facing
trigger1 = animelem = 7


[State 0, VelSet]
type = VelSet
trigger1 = animelem = 5
x = Map(BineyVelX)*.4
y = cond(Map(BineyPosY)<=0,Map(BineyVelY)*.4,0)

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .975
y = .975

[State 210, 5]
type = ChangeState
triggerall = pos y = 0
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 210, 5]
type = ChangeState
triggerall = pos y < 0
trigger1 = AnimTime = 0
value = 50
ctrl = 1

