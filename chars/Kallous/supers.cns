;63214A
[Statedef 3000]
type    = S
movetype= I
physics = S
anim = 2999
velset = vel x,0
ctrl = 0
poweradd = -500

[State 0, SuperPause]
type = SuperPause
trigger1 = time = 0
time = 24
darken = 1
p2defmul = 1

[State 0, Helper]
type = Helper
triggerall = anim = 2999
trigger1 = animelem = 3
helpertype = Normal ;Player
name = "WindGrab"
ID = 3001
stateno = 3001
pos = 50,-35
postype = P1    ;P2, Front, Back, Left, Right
facing = 1
keyctrl = 0
ownpal = 0

[State 0, ChangeAnim]
type = ChangeAnim
triggerall = anim = 2999
triggerall = time > 9
trigger1 = command != "holdx"
value = 3002


[State 1000, 7]
type = ChangeState
triggerall = anim = 3002
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Wind Aim
[Statedef 3001]
type    = U
movetype= I
physics = N
anim = 3000
velset = 0,0
ctrl = 0

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = .9
y = .9

[State 0, VelAdd]
type = VelSet
trigger1 = root,command = "holdfwd"
x = 1.5
[State 0, VelAdd]
type = VelSet
trigger1 = root,command = "holdback"
x = -1.5

[State 0, VelAdd]
type = VelSet
trigger1 = root,command = "holddown"
y = 1.5
[State 0, VelAdd]
type = VelSet
trigger1 = root,command = "holdup"
y = -1.5

[State 1000, 7]
type = ChangeState
trigger1 = root,anim = 3002
value = 3002

[State 1000, 7]
type = DestroySelf
trigger1 = root,movetype = H

;---------------------------------------------------------------------------
;Wind Grab
[Statedef 3002]
type    = U
movetype= A
physics = N
anim = 3001
velset = 0,0
ctrl = 0

[State 200, 1]
type = HitDef
triggerall = enemy,stateno = [5000,5999]
trigger1 = !MoveContact && !MoveReversed
attr = S,HT                     ;Attribute: Standing, Normal Attack
damage = 0,0
animtype = Up                ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag =                    ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 6, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 0,0               ;Time attacker pauses, time opponent shakes
sparkno = -1                    ;Spark anim no (Def: set above)
sparkxy = -10, -5               ;X-offset for the "hit spark" rel. to p2,
hitsound = -1                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 10            ;Time that the opponent slides back
ground.hittime  = 45
ground.velocity = 0,-17
guard.velocity = -4
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = 0,-15
air.hittime = 200
fall = 1
fall.yvelocity = 0
guard.ctrltime = 10
guard.hittime = 10
p2facing = facing = root,facing
guard.dist = 0
fall.damage = ceil(cond(300*root,Map(DamageScaling) < 150, 150, 300*root,Map(DamageScaling)))
id = 5111


