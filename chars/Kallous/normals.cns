;---------------------------------------------------------------------------
; 5A
[Statedef 200]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 200                       
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)
facep2 = 1

[State -2, PushBack]
type = mapset
triggerall = enemy,statetype != A
trigger1 = movehit && combocount>5
value = Map(PushBack)+1
map = "PushBack"
ignorehitpause = 1
persistent = 0
[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit && combocount=1
value = Map(DamageScaling)*.75
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit && combocount>1
value = Map(DamageScaling)-.05
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
[State -2, Hitstun Scaling]
type = mapset
triggerall = enemy,statetype = A && enemy,movetype = H
trigger1 = movehit
value = Map(HitstunScaling)+1
map = "HitstunScaling"
ignorehitpause = 1
persistent = 0

[State 0, PosAdd]
type = PosAdd
trigger1 = animelem = 2
x = 1

[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !MoveReversed
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = ceil(cond(15*Map(DamageScaling) < 2, 2, 15*Map(DamageScaling)))
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 1, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 7,7                ;Time attacker pauses, time opponent shakes
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = -5, -55              ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0               ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = -2.5-(Map(PushBack))
guard.velocity = -3
airguard.velocity = -1.75,-1.5
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.25,-1.6       ;X-velocity at which opponent is pushed,
air.hittime = ceil(cond(20-Map(HitstunScaling) < 8, 8, 20-Map(HitstunScaling)))
forcenofall = 1
fall.yvelocity = 0
guard.ctrltime = 10
guard.hittime = 10
ground.cornerpush.veloff = -2.25-(Map(PushBack))
air.cornerpush.veloff = -1
p2facing = 1
guard.dist = 0
getpower = (20*Map(DamageScaling)/2)+5,5
givepower = (20*Map(DamageScaling)/2),4


[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 4
statetype = S       
movetype = I        
physics = S        

[State 200, 2]
type = PlaySnd
trigger1 = Time = 1
value = F4, 0

[State 200, 2]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 210, 5]
type = ChangeState
triggerall = command = "28"
trigger1 = MoveContact
value = 60
ctrl = 0
[State 210, 5]
type = ChangeState
triggerall = command = "holdup"
trigger1 = MoveContact
value = 40
ctrl = 0


[State 200, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

