;---------------------------------------------------------------------------
;Wave
[Statedef 1003]
type    = U
movetype= A
physics = N
anim = 1002
velset = 7.5,0
ctrl = 0

[State -2, Starter Damage Scaling]
type = mapset
trigger1 = movehit=1 && combocount=1
value = root,Map(DamageScaling)*.9
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
redirectID = root,ID
[State -2, Damage Scaling]
type = mapset
trigger1 = movehit=1 && combocount>1
value = root,Map(DamageScaling)-.065
map = "DamageScaling"
ignorehitpause = 1
persistent = 0
redirectID = root,ID
[State -2, Hitstun Scaling]
type = mapset
triggerall = enemy,statetype = A || enemy,statetype = L && enemy,movetype = H
trigger1 = movehit=1
value = root,Map(HitstunScaling)+.5+cond(root,Map(Wave)>4,1,0)
map = "HitstunScaling"
persistent = 0
redirectID = root,ID


[State 200, 1]
type = HitDef
trigger1 = !MoveContact && !Movereversed
attr = S,NP                     ;Attribute: Standing, Normal Attack
damage = ceil(cond(50*root,Map(DamageScaling) < 5, 5, 50*root,Map(DamageScaling))),15
animtype = Up                ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAFD                    ;Flags of conditions that move can hit
priority = 6, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
pausetime = 1,4                ;Time attacker pauses, time opponent shakes
sparkno = 2                     ;Spark anim no (Def: set above)
sparkxy = -10, -5               ;X-offset for the "hit spark" rel. to p2,
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 16           ;Time that the opponent slides back
ground.hittime  = 16
ground.velocity = .75,-5.4
guard.velocity = -4
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = .75,-4.9
down.velocity = -.5,-5.6
air.hittime = ceil(cond(50-root,Map(HitstunScaling) < 24, 24, 50-root,Map(HitstunScaling)))
down.hittime = ceil(cond(40-root,Map(HitstunScaling) < 20, 20, 40-root,Map(HitstunScaling)))
forcenofall = 1
fall.yvelocity = 0
guard.ctrltime = 16
guard.hittime = 16
yaccel = .29
getpower = (30*root,Map(DamageScaling)/2)+10

[State -2, wave]
type = mapadd
trigger1 = movehit=1
value = 1
map = "Wave"
ignorehitpause = 1
directID = root,ID

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AT,AP
time = 1

